# 复制为 .env 后可直接用于本地开发。
# docker compose 会把后端的 DATABASE_URL 改写为 postgres 服务名。

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

JWT_SECRET=dev-local-jwt-secret-change-me
JWT_EXPIRE_MINUTES=720

# 仅在该用户名不存在时创建。上线前请修改。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-123456

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 发布文档时用这个模型把片段写成向量。首次发布会下载到 data/models。
# 当前向量维度是 512。更换模型需要同时改维度并做数据库迁移。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 对话回答使用 OpenAI 兼容接口。查资料时会把检索到的原文交给这个模型。
# DeepSeek：CHAT_BASE_URL=https://api.deepseek.com  CHAT_MODEL=deepseek-chat
# 通义千问：CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  CHAT_MODEL=qwen-plus
# OpenAI：CHAT_BASE_URL=https://api.openai.com/v1  CHAT_MODEL=gpt-4o-mini
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
